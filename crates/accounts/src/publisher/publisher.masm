use miden::core::sys
use miden::protocol::native_account
use miden::protocol::active_account
use miden::core::word
# CONSTANTS
# =================================================================================================

#! Mapping containing the prices published for the fetcher.
const ENTRIES_MAP_SLOT=word("pragma::publisher::entries")

#! Writes a new entry.
#! Must be called by the publisher.
#! The price will be stored in the publisher map for the given asset, overriding the
#! last value.
#!
#! Inputs:  [pair_key_word, ENTRY] ; ENTRY being [timestamp, decimals, price, num_sources]
#! Outputs: []
#!
@account_procedure
pub proc publish_entry
    push.ENTRIES_MAP_SLOT[0..2] exec.native_account::set_map_item
    # Truncate just in case
    exec.sys::truncate_stack
end

#! Get the published entry for a pair.
#!
#! Inputs:  [pair_key_word]
#! Outputs: [ENTRY] ; Word being [timestamp, decimals, price, num_sources], all 0 if never published
#!
@account_procedure
pub proc get_entry
    push.ENTRIES_MAP_SLOT[0..2]

    # => [entries_map_slot, faucet_id_word]
    exec.active_account::get_map_item

    # => [ENTRY]
    exec.sys::truncate_stack
end
